{
  "name": "@cmokit/cli",
  "version": "0.2.0",
  "description": "Configuration and command line for CMOkit: defineConfig for a cmokit.config.ts, and the cmokit command and MCP server, which make the experiments tool match it and read its estimates and results.",
  "license": "Apache-2.0",
  "author": "Growth Science LLC",
  "homepage": "https://github.com/cmokit/cmokit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmokit/cmokit.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/cmokit/cmokit/issues",
  "type": "module",
  "bin": {
    "cmokit": "dist/bin.js"
  },
  "exports": {
    ".": {
      "cmokit-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
