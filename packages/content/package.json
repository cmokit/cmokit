{
  "name": "@cmokit/content",
  "version": "0.1.0",
  "description": "The content server, as a Cloudflare Worker: the content plugin's remote MCP connector, each customer's brand context, pieces and connections in a Durable Object of its own, and events read from the event platform.",
  "license": "Apache-2.0",
  "author": "Growth Science LLC",
  "homepage": "https://github.com/cmokit/cmokit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmokit/cmokit.git",
    "directory": "packages/content"
  },
  "bugs": "https://github.com/cmokit/cmokit/issues",
  "type": "module",
  "exports": {
    ".": {
      "cmokit-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "cmokit-source": "./src/worker.ts",
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./apps/waitlist.html": {
      "default": "./dist/apps/waitlist.html"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@cmokit/issuer": "^0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:apps",
    "build:apps": "vite build -c apps/vite.config.ts --logLevel warn"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "zod": "4.6.7"
  }
}
