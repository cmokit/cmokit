{
  "name": "@cmokit/lifecycle",
  "version": "0.1.0",
  "description": "The lifecycle, as a Cloudflare Worker: each lead's sequence of messages in a Durable Object of its own, sent through SendGrid. Reached through the edge.",
  "license": "Apache-2.0",
  "author": "Growth Science LLC",
  "homepage": "https://github.com/cmokit/cmokit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmokit/cmokit.git",
    "directory": "packages/lifecycle"
  },
  "bugs": "https://github.com/cmokit/cmokit/issues",
  "type": "module",
  "exports": {
    ".": {
      "cmokit-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "cmokit-source": "./src/worker.ts",
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@cmokit/cli": "^0.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
