{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cmokit-content",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  // A Worker custom domain: the deploy creates the DNS record and the certificate.
  "routes": [
    { "pattern": "mcp.cmokit.ai", "custom_domain": true },
    // The account page (ADR-0041), served by the same Worker at an origin of its own.
    { "pattern": "app.cmokit.ai", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ISSUER_URL": "https://auth.cmokit.ai",
    "AUDIENCE": "https://mcp.cmokit.ai/mcp",
    "APP_URL": "https://app.cmokit.ai"
  },
  "durable_objects": { "bindings": [{ "name": "CUSTOMERS", "class_name": "Customer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Customer"] }],
  // The issuer, deployed first. The billing lifecycle is CMOkit's own site's lifecycle Worker, which
  // binds back to `Access`; until it exists, the workflow deploys without it.
  "services": [
    { "binding": "ISSUER", "service": "cmokit-issuer" },
    { "binding": "LIFECYCLE", "service": "cmokit-site-lifecycle" }
  ],
  // Slows joins to every brand's waitlist from one address: 10 a minute (ADR-0043).
  "ratelimits": [{ "name": "JOINS", "namespace_id": "1043", "simple": { "limit": 10, "period": 60 } }],
  "observability": { "enabled": true }
}
