{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cmokit-issuer",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  // The fonts of CMOKit's own look, bundled as bytes (ADR-0046).
  "rules": [{ "type": "Data", "globs": ["**/*.woff2"], "fallthrough": true }],
  // Better Auth fetches a client's metadata document, which needs the first flag, and uses Node's
  // AsyncLocalStorage, which needs the second.
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  // A Worker custom domain: the deploy creates the DNS record and the certificate.
  "routes": [{ "pattern": "auth.cmokit.ai", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ISSUER_URL": "https://auth.cmokit.ai",
    "AUDIENCE": "https://mcp.cmokit.ai/mcp",
    "MAIL_FROM": "signin@cmokit.ai",
    "APP_URL": "https://app.cmokit.ai",
    // The beta terms; their version is read from the page itself (ADR-0047).
    "TERMS_URL": "https://cmokit.ai/beta-terms/"
  },
  // Better Auth's people, ways in, sessions, clients and hashed tokens, with CMOKit's brand index
  // (ADR-0018, ADR-0035). The first deploy creates the database.
  "d1_databases": [{ "binding": "DB", "database_name": "cmokit-issuer" }],
  // The old records, from before Better Auth: the old OAuth library's grants, which list the people
  // to copy, and one object per person and per way in. The copy reads them and leaves them as they are.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "durable_objects": {
    "bindings": [
      { "name": "IDENTITIES", "class_name": "Identity" },
      { "name": "PEOPLE", "class_name": "Person" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Identity", "Person"] }],
  "observability": { "enabled": true }
}
