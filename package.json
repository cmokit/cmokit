{
  "name": "cmokit-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "packages/create-cmokit/template"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run check:decisions && npm run check:boundaries && npm run check:architecture",
    "typecheck": "tsc",
    "check:decisions": "node scripts/check-decisions.ts",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "test": "node --conditions=cmokit-source --test \"packages/*/test/*.test.ts\" \"scripts/test/*.test.ts\"",
    "build": "npm run build -w @cmokit/cli && npm run build -w @cmokit/edge -w @cmokit/astro -w @cmokit/lifecycle -w @cmokit/content -w @cmokit/issuer -w create-cmokit",
    "build:starter": "npm run build -w cmokit-site",
    "check:architecture": "node scripts/architecture.ts --check",
    "docs": "node scripts/architecture.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "astro": "^7.4.2",
    "typescript": "^7.0.2"
  }
}
